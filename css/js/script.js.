========================================= */

const ghost = document.getElementById("ghostCursor");

const hasFinePointer = window.matchMedia(
  "(hover: hover) and (pointer: fine)"
).matches;

if (ghost && hasFinePointer) {
  let mouseX = 0, mouseY = 0;
  let ghostX = 0, ghostY = 0;

  document.addEventListener("mousemove", e => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    ghost.classList.add("visible");
  });

  function animateGhost() {
    ghostX += (mouseX - ghostX) * 0.14;
    ghostY += (mouseY - ghostY) * 0.14;
    ghost.style.left = `${ghostX}px`;
    ghost.style.top = `${ghostY}px`;
    requestAnimationFrame(animateGhost);
  }

  animateGhost();

  document.querySelectorAll("a, button").forEach(el => {
    el.addEventListener("mouseenter", () => ghost.classList.add("excited"));
    el.addEventListener("mouseleave", () => ghost.classList.remove("excited"));
  });
} else if (ghost) {
  ghost.style.display = "none";
}


/* =========================================
   TRANSICIONES
========================================= */

const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("revealed");
    }
  });
}, { threshold: 0.12 });

document.querySelectorAll(".section").forEach(section => {
  observer.observe(section);
});


