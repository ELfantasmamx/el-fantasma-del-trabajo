/* =========================================
   ESTADO DEL CUESTIONARIO
========================================= */

const quickButton = document.getElementById("quickQuizButton");
const deepButton = document.getElementById("deepQuizButton");
const container = document.getElementById("quizContainer");
const result = document.getElementById("quizResult");
const content = document.getElementById("quizContent");

const counter = document.getElementById("quizCounter");
const progress = document.getElementById("progressFill");

const previous = document.getElementById("previousQuestion");
const next = document.getElementById("nextQuestion");
const exit = document.getElementById("exitQuiz");
const restart = document.getElementById("restartQuiz");

let questions = [];
let answers = [];
let current = 0;
let mode = "quick";

const dimensions = {
  rumination: "Pensamientos laborales recurrentes",
  boundaries: "Límites entre trabajo y vida personal",
  disconnection: "Desconexión psicológica",
  recovery: "Recuperación personal"
};

const recommendations = {
  rumination: "Intenta realizar un cierre de jornada. Anota tus pendientes para retomarlos en tu siguiente horario laboral.",
  boundaries: "Establece horarios de disponibilidad y procura comunicar tus límites laborales.",
  disconnection: "Dedica momentos a actividades que requieran tu atención y te permitan conectar con el presente.",
  recovery: "Reserva espacios para descansar, realizar actividades recreativas y recuperar energía."
};

function startQuiz(type) {
  mode = type;
  questions = type === "quick" ? quickQuestions : deepQuestions;
  answers = new Array(questions.length).fill(null);
  current = 0;

  container.hidden = false;
  result.hidden = true;

  document.querySelector(".quiz-grid").hidden = true;

  renderQuestion();

  container.scrollIntoView({ behavior: "smooth", block: "start" });
}

function renderQuestion() {
  const question = questions[current];

  counter.textContent = `Pregunta ${current + 1} de ${questions.length}`;
  progress.style.width = `${((current + 1) / questions.length) * 100}%`;

  previous.disabled = current === 0;
  next.textContent = current === questions.length - 1
    ? "Ver resultados →"
    : "Continuar →";

  content.innerHTML = `
    <div class="question-label">REFLEXIÓN PERSONAL</div>
    <h3 class="question-title">${question.text}</h3>
    <div class="answer-list">
      ${frequencyOptions.map((option, index) => `
        <button class="answer-option ${answers[current] === index ? "selected" : ""}"
          data-answer="${index}">
          ${option}
        </button>
      `).join("")}
    </div>
  `;

  content.querySelectorAll(".answer-option").forEach(button => {
    button.addEventListener("click", () => {
      answers[current] = Number(button.dataset.answer);
      renderQuestion();
    });
  });
}

function getScore(question, answer) {
  return question.reverse ? 4 - answer : answer;
}

function calculateResults() {
  const scores = {};
  const totals = {};

  Object.keys(dimensions).forEach(key => {
    scores[key] = 0;
    totals[key] = 0;
  });

  questions.forEach((question, index) => {
    const key = question.dimension;
    scores[key] += getScore(question, answers[index]);
    totals[key]++;
  });

  Object.keys(scores).forEach(key => {
    scores[key] = totals[key]
      ? scores[key] / (totals[key] * 4) * 100
      : 0;
  });

  return scores;
}

function showResults() {
  const scores = calculateResults();

  let average = answers.reduce((sum, answer, index) => {
    return sum + getScore(questions[index], answer);
  }, 0) / (answers.length * 4) * 100;

  const strongest = Object.keys(scores).sort(
    (a, b) => scores[b] - scores[a]
  )[0];

  let title = "Una oportunidad para cuidarte";
  let description = "Tus respuestas ofrecen un punto de partida para observar cómo estás viviendo tu tiempo fuera del trabajo.";

  if (average >= 65) {
    title = "El trabajo sigue presente";
    description = "Tus respuestas sugieren que algunas experiencias laborales pueden estar ocupando un espacio importante durante tu tiempo personal. Puede ser útil fortalecer tus límites y estrategias de recuperación.";
  } else if (average >= 35) {
    title = "Entre el trabajo y tu espacio personal";
    description = "Tus respuestas reflejan una experiencia intermedia. Hay aspectos de tu desconexión y recuperación que podrías explorar y fortalecer.";
  } else {
    title = "Un espacio para seguir cultivando";
    description = "Tus respuestas indican una menor presencia de las dificultades exploradas. Mantener tus hábitos de descanso y tus límites puede ayudarte a conservar ese equilibrio.";
  }

  document.getElementById("resultTitle").textContent = title;
  document.getElementById("resultScore").textContent =
    `${Math.round(average)} / 100`;

  document.getElementById("resultDescription").textContent =
    description;

  const dimensionsContainer =
    document.getElementById("resultDimensions");

  dimensionsContainer.innerHTML = "";

  Object.keys(dimensions).forEach(key => {
    const value = Math.round(scores[key]);

    const item = document.createElement("div");
    item.className = "dimension-item";

    const label = document.createElement("span");
    label.textContent = dimensions[key];

    const track = document.createElement("div");
    track.className = "dimension-track";

    const fill = document.createElement("div");
    fill.className = "dimension-fill";
    fill.style.width = `${value}%`;

    track.appendChild(fill);
    item.append(label, track);
    dimensionsContainer.appendChild(item);
  });

  document.getElementById("resultRecommendation").textContent =
    recommendations[strongest];

  container.hidden = true;
  result.hidden = false;

  result.scrollIntoView({ behavior: "smooth", block: "start" });
}


/* =========================================
   BOTONES Y NAVEGACIÓN
========================================= */

quickButton.addEventListener("click", () => startQuiz("quick"));
deepButton.addEventListener("click", () => startQuiz("deep"));

next.addEventListener("click", () => {
  if (answers[current] === null) {
    alert("Selecciona una respuesta para continuar.");
    return;
  }

  if (current < questions.length - 1) {
    current++;
    renderQuestion();
  } else {
    showResults();
  }
});

previous.addEventListener("click", () => {
  if (current > 0) {
    current--;
    renderQuestion();
  }
});

exit.addEventListener("click", () => {
  container.hidden = true;
  result.hidden = true;
  document.querySelector(".quiz-grid").hidden = false;
});

restart.addEventListener("click", () => {
  startQuiz(mode);
});


